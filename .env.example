# Copy to .env and fill in. Never commit the filled file.
# In production these live in the Vercel project settings, not in a file.

# Runtime (Vercel sets NODE_ENV=production itself)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database.
#   Production: a postgres:// connection string (Neon, pooled endpoint, sslmode=require).
#   Local: leave empty. It defaults to ./data/pglite — Postgres running in-process, nothing to
#   install. `memory://` gives a throwaway database that disappears when the process exits.
DATABASE_URL=

# Session cookie signing key. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Basic auth for Swagger UI. Required whenever NODE_ENV is not development.
SWAGGER_USER=
SWAGGER_PASSWORD=

# Frontend: base URL of the API. Anything prefixed VITE_ is public and ships in the bundle.
VITE_API_URL=/api
