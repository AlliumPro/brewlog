# Copy to .env and fill in. Never commit the filled file.

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (SQLite file path, relative to apps/api or absolute)
DATABASE_URL=

# Site-wide password gate.
# Generate the hash with: npm run auth:hash --workspace @brewlog/api
AUTH_PASSWORD_HASH=

# Session cookie signing key. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Photo uploads directory (must be writable, mounted as a volume in Docker)
UPLOAD_DIR=

# Basic auth for Swagger UI. Required whenever NODE_ENV is not development.
SWAGGER_USER=
SWAGGER_PASSWORD=

# Frontend: base URL of the API. Anything prefixed VITE_ is public and ships in the bundle.
VITE_API_URL=/api
